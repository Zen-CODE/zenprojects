{
    "zenplayer_url": "http://9.0.0.2:9001",
    "hotkeymap": {
        "<alt>+z": {
            "function": "zenmpd",
            "params": ["previous"]
        },
        "<alt>+x": {
            "function": "zenmpd",
            "params": ["pause"]
        },
        "<alt>+v": {
            "function": "zenmpd",
            "params": ["stop"]
        },
        "<alt>+b": {
            "function": "zenmpd",
            "params": ["next"]
        },
        "<alt>+9": {
            "function": "zenmpd",
            "params": ["voldown"]
        },
        "<alt>+0": {
            "function": "zenmpd",
            "params": ["volup"]
        },
        "<alt>+q": {
            "function": "controller",
            "params": ["quit"]
        }
    }
}
